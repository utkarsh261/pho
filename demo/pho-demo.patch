diff --git a/internal/ui/views/prdetail/slowmo.go b/internal/ui/views/prdetail/slowmo.go
new file mode 100644
index 0000000..8ebacb6
--- /dev/null
+++ b/internal/ui/views/prdetail/slowmo.go
@@ -0,0 +1,16 @@
+package prdetail
+
+import (
+	"os"
+	"strconv"
+	"time"
+)
+
+// slowmo stretches status-message timers when the app is recorded in slow
+// motion (PHO_SLOWMO=3), so they last their normal length on playback.
+var slowmo = func() time.Duration {
+	if n, err := strconv.Atoi(os.Getenv("PHO_SLOWMO")); err == nil && n > 0 {
+		return time.Duration(n)
+	}
+	return 1
+}()
